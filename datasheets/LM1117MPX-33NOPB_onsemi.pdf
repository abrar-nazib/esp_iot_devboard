         <xmp:MetadataDate>2021-02-22T11:51:40-07:00</xmp:MetadataDate>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">LM1117 - 800 mA Low-Dropout Linear Regulator</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ON Semiconductor</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The LM1117 is a low dropout voltage regulator with a dropout of&#xA;1.2 V at 800 mA of load current. The LM1117 is available in an&#xA;adjustable version, which can set the output voltage from 1.25 to&#xA;13.8 V with only two external resistors.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <pdf:Producer>Acrobat Distiller 21.0 (Windows)</pdf:Producer>
         <pdf:Keywords/>
         <xmpMM:DocumentID>uuid:a58599c7-efe5-465f-bdc5-e1a62d352c80</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:9a462458-5bd2-49e7-81f6-584174146004</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
